    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/jquery": "^3.5.30",
    "@types/node": "^18.18.0",
    "angular-eslint": "18.4.3",
    "browser-sync": "^3.0.0",
    "eslint": "^9.15.0",
    "grunt": "^1.3.0",
    "grunt-purifycss": "^0.1.2",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
