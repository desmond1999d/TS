{
  "name": "ton-service",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build-prod": "ng build --configuration production",
    "test": "ng test",
    "lint": "ng lint",
    "dev:ssr": "ng run ton-service:serve-ssr",
    "serve:ssr": "node dist/ton-service/server/main.js",
    "build:ssr": "ng build && ng run ton-service:server",
    "build:ssr:docker": "ng build --configuration docker && ng run ton-service:server:docker",
    "prerender": "ng run ton-service:prerender"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/common": "^18.2.14",
